// 개발용 설정
// xcconfig에서 // 는 주석이라 주소의 // 는 /$()/ 로 쓴다.

// 백엔드 시연 서버 (Render, develop 브랜치 자동 배포) — 주소는 백엔드 팀에 [확인 필요]
// 휴대폰 인증번호는 시연 기간 동안 123456 고정
PAWFIT_API_BASE_URL = https:/$()/pawfit-api.onrender.com/api/v1

// NO = 위 서버로 요청, YES = 서버 없이 앱 안 가짜 데이터(목업)
PAWFIT_USE_MOCK_API = NO

// 내 컴퓨터에서 백엔드를 띄울 때는 Local.xcconfig를 만들어 덮어쓴다(저장소에 안 올라감).
//   PAWFIT_API_BASE_URL = http:/$()/localhost:8080/api/v1   ← 시뮬레이터에서만, ATS 예외 필요
#include? "Local.xcconfig"
