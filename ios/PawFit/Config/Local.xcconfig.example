// 이 파일을 Local.xcconfig로 복사해서 쓴다. (Local.xcconfig는 .gitignore에 있음)

// 배포된 백엔드로 연결하는 기본 예제. .example 파일 자체는 앱이 읽지 않아요.
PAWFIT_API_BASE_URL = https:/$()/pawfit-api.onrender.com/api/v1
PAWFIT_USE_MOCK_API = NO

// xcconfig에서 // 는 주석이므로 주소는 위처럼 /$()/ 로 써요.
// 서버 없이 화면만 보려면 위 PAWFIT_USE_MOCK_API를 YES로 바꿔요.

// 내 맥에서 백엔드를 띄웠을 때 (시뮬레이터)
// PAWFIT_API_BASE_URL = http:/$()/localhost:8080/api/v1
